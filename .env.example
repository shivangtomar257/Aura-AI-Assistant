# Application Mode
APP_NAME="Aura AI Personal Assistant"
APP_ENV=development
SIMULATION_MODE=true
DATABASE_PATH=./data/assistant_state.json
GOOGLE_TOKEN_PATH=./data/google_token.json

# LLM & Gemini Voice TTS (Optional - falls back to built-in NLP & browser speech if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VOICE_NAME=Kore
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gmail API OAuth2 (Optional - used when SIMULATION_MODE=false)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Twilio Programmable Voice (Optional - used when SIMULATION_MODE=false)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
